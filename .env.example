# Copy to .env and fill in at least one provider key.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Model as "<provider>:<model-id>". Providers: anthropic, openai.
MIVRA_MODEL=anthropic:claude-sonnet-5-5

# Where the SQLite database lives. Defaults to ~/.mivra
# MIVRA_DATA_DIR=

# Server port. The server binds to 127.0.0.1 only (ADR-001: remote access is opt-in).
# MIVRA_PORT=4096

# Extra Host names the server accepts besides loopback, comma-separated. Only needed when the
# production server sits behind a proxy such as `tailscale serve 4096`.
# MIVRA_ALLOWED_HOSTS=prestige.tail52dcb6.ts.net

# Dev only: the interface Vite listens on. Defaults to 127.0.0.1; prefer `tailscale serve 5173`.
# MIVRA_DEV_HOST=127.0.0.1
