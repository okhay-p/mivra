# Copy to .env and fill in the key for the provider you use.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Model as "<provider>:<model-id>". Providers: anthropic, openai, openrouter.
# For OpenRouter, use the model id exactly as listed on https://openrouter.ai/models, e.g.
#   MIVRA_MODEL=openrouter:<vendor>/<model>
#   MIVRA_MODEL=openrouter:<vendor>/<model>:free
# Only the first-run default: change the model in the picker under the message box (ADR-012).
MIVRA_MODEL=anthropic:claude-sonnet-5-5
# OpenRouter models only: none, minimal, low, medium, high, xhigh or max. Unset uses the model's default.
# MIVRA_REASONING_EFFORT=medium

# Where the SQLite database lives. Defaults to ~/.mivra
# MIVRA_DATA_DIR=

# Server port. The server binds to 127.0.0.1 only (ADR-001: remote access is opt-in).
# MIVRA_PORT=4096

# Extra Host names the server accepts besides loopback, comma-separated. Only needed when the
# production server sits behind a proxy such as `tailscale serve 4096`.
# MIVRA_ALLOWED_HOSTS=prestige.tail52dcb6.ts.net

# Dev only: the interface Vite listens on. Defaults to 127.0.0.1; prefer `tailscale serve 5173`.
# MIVRA_DEV_HOST=127.0.0.1
