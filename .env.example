# Copy to .env and add at least one provider key. OpenRouter (https://openrouter.ai/keys) reaches every model.
# The model and reasoning effort are chosen in the picker under the message box, not here (ADR-012).
# Until you pick one, Mivra uses GPT-6 Luna at high reasoning effort: through OpenRouter when its key is set,
# otherwise through OpenAI, otherwise Claude Sonnet 5.5 through Anthropic.
OPENROUTER_API_KEY=

# Optional: call Anthropic or OpenAI directly. Each provider's models show in the picker only when its key is set.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Where the SQLite database lives. Defaults to ~/.mivra
# MIVRA_DATA_DIR=

# Server port. The server binds to 127.0.0.1 only (ADR-001: remote access is opt-in).
# MIVRA_PORT=4096

# Extra Host names the server accepts besides loopback, comma-separated. Only needed when the
# production server sits behind a proxy such as `tailscale serve 4096`.
# MIVRA_ALLOWED_HOSTS=prestige.tail52dcb6.ts.net

# Dev only: the interface Vite listens on. Defaults to 127.0.0.1; prefer `tailscale serve 5173`.
# MIVRA_DEV_HOST=127.0.0.1
