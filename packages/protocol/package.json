{
  "name": "@mivra/protocol",
  "private": true,
  "type": "module",
  "description": "Versioned schemas for Mivra learning artifacts, shared by server and web (ADR-006).",
  "exports": {
    ".": {
      "@mivra/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./test/composition-fixtures": {
      "@mivra/source": "./test/composition-fixtures.ts"
    },
    "./test/code-exercise-fixtures": {
      "@mivra/source": "./test/code-exercise-fixtures.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "@types/node": "^22.20.5",
    "quickjs-emscripten-core": "0.32.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
