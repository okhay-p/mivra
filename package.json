{
  "name": "mivra",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./packages/*\" dev",
    "build": "pnpm --filter @mivra/web build && pnpm --filter @mivra/server build",
    "start": "pnpm --filter @mivra/server start",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  }
}
