{
  "name": "mivra",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./packages/*\" dev",
    "build": "pnpm --filter @mivra/protocol build && pnpm --filter @mivra/web build && pnpm --filter @mivra/server build",
    "start": "pnpm --filter @mivra/server start",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @mivra/e2e test:e2e",
    "test:e2e:all": "pnpm --filter @mivra/e2e test:e2e:all",
    "typecheck": "pnpm -r typecheck"
  },
  "pnpm": {
    "patchedDependencies": {
      "@openrouter/ai-sdk-provider@3.1.0": "patches/@openrouter__ai-sdk-provider@3.1.0.patch"
    }
  }
}
